rules_version = '2';

// F2-6 — Faz 2 kapsamında ince taneli rol/salon bazlı kurallar.
// Custom claim'ler (role/gymId) F2-5'teki trigger ile setCustomUserClaims'e
// yazılıyor; burada request.auth.token.role / .gymId olarak okunuyor.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return request.auth.token.role;
    }

    function myGymId() {
      return request.auth.token.gymId;
    }

    // gyms/{gymId} — sadece o salonun admin'i yazabilir, kimliği doğrulanmış
    // herkes kendi salonu için okuyabilir. Alt koleksiyonlar (themes vb.)
    // aynı kurala tabi.
    match /gyms/{gymId} {
      allow read: if isSignedIn() && myGymId() == gymId;
      allow write: if isSignedIn() && myRole() == 'admin' && myGymId() == gymId;

      match /{document=**} {
        allow read: if isSignedIn() && myGymId() == gymId;
        allow write: if isSignedIn() && myRole() == 'admin' && myGymId() == gymId;
      }
    }

    // users/{uid} — F1-10 (telefon numarasıyla kendi kaydını arama, Admin
    // SDK ile — kurallara tabi değil) ve F2-1/F2-2 (admin başka kullanıcı
    // dokümanı oluşturuyor) ile uyumlu:
    // - herkes kendi dokümanını okuyabilir
    // - admin kendi salonundaki (gymId eşleşen) herkesi okuyabilir/yazabilir
    // - antrenör sadece trainerId == kendi uid'si olan üyeleri okuyabilir
    match /users/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        (myRole() == 'admin' && resource.data.gymId == myGymId()) ||
        (myRole() == 'trainer' && resource.data.trainerId == request.auth.uid)
      );

      allow create: if isSignedIn() && (
        request.auth.uid == uid ||
        (myRole() == 'admin' && request.resource.data.gymId == myGymId())
      );

      allow update: if isSignedIn() && (
        request.auth.uid == uid ||
        (myRole() == 'admin' &&
          resource.data.gymId == myGymId() &&
          request.resource.data.gymId == myGymId()) ||
        // F3-5 — antrenör, kendine atanmış üyenin SADECE remainingSessions
        // alanını, ders tamamlama transaction'ının parçası olarak düşürür.
        (myRole() == 'trainer' &&
          resource.data.trainerId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['remainingSessions']))
      );

      allow delete: if isSignedIn() && myRole() == 'admin' && resource.data.gymId == myGymId();
    }

    // memberPackages/{id} — F3-2. Fiyat alanları (totalAmount/paidAmount/
    // dueAmount) içerdiği için sadece admin erişebilir; üye kendi paketini
    // ayrı, fiyatsız bir görünümden (users/{uid} üzerindeki denormalize
    // remainingSessions/packageEndDate alanları) okur, bu koleksiyona hiç
    // dokunmaz.
    match /memberPackages/{packageId} {
      allow read, update, delete: if isSignedIn() && myRole() == 'admin' && resource.data.gymId == myGymId();
      allow create: if isSignedIn() && myRole() == 'admin' && request.resource.data.gymId == myGymId();
    }

    // sessions/{sessionId} — F3-3. Oluşturma sadece admin ekranlarından
    // (client'ta başka bir yol yok). İptal/erteleme admin için her zaman
    // izinli; antrenör/üye kendi seansı içinse ve başlangıca 24 saatten
    // fazla varsa izinli. Remote Config'teki cancellationDeadlineHours
    // (varsayılan 24) buradaki 24 saatlik sabitle senkron tutulmalı —
    // Security Rules harici bir servise (Remote Config) erişemediği için
    // buraya sabit olarak yazılıyor.
    function isOwnSession() {
      return (myRole() == 'trainer' && resource.data.trainerId == request.auth.uid) ||
             (myRole() == 'member' && resource.data.memberId == request.auth.uid);
    }

    function withinCancellationWindow() {
      return resource.data.startTime - request.time > duration.value(24, 'h');
    }

    // F3-4 — üye "Gelicem"/"Gelmeyeceğim" derken sadece kendi seansının
    // memberConfirmation alanını değiştiriyor; bu, 24 saatlik iptal
    // penceresinden bağımsız (dersten 1 saat önce de onay verebilmeli).
    function isOwnMemberSession() {
      return myRole() == 'member' && resource.data.memberId == request.auth.uid;
    }

    function onlyChangesConfirmation() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberConfirmation']);
    }

    // F3-5 — antrenör kendi seansını "tamamlandı"/"üye gelmedi" olarak
    // işaretlerken sadece status+attended alanlarını değiştiriyor; bu,
    // ders zaten bittiği (dolayısıyla 24 saatlik pencerenin çoktan geçmiş
    // olacağı) için 24 saat kuralından bağımsız tutuluyor.
    function isCompletingOwnSession() {
      return myRole() == 'trainer' &&
        resource.data.trainerId == request.auth.uid &&
        resource.data.status == 'planned' &&
        request.resource.data.status == 'completed' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'attended']);
    }

    match /sessions/{sessionId} {
      allow read: if isSignedIn() && resource.data.gymId == myGymId();
      allow create: if isSignedIn() && myRole() == 'admin' && request.resource.data.gymId == myGymId();
      allow update, delete: if isSignedIn() && resource.data.gymId == myGymId() && (
        myRole() == 'admin' ||
        (isOwnSession() && withinCancellationWindow()) ||
        (isOwnMemberSession() && onlyChangesConfirmation()) ||
        isCompletingOwnSession()
      );
    }

    // measurements/{uid}/entries/{entryId} — F4-1. Vücut ölçümü kişisel/
    // hassas sağlık verisi (F0-4 gizlilik politikası kapsamında) ama admin
    // ve kendi antrenörü, üyenin ölçüm ekranını üye detayından açıp
    // görüntüleyip düzenleyebiliyor (stüdyo içi kullanım) — üçüncü bir
    // salonun admin/antrenörüne asla açılmıyor. `targetUser()` bir ekstra
    // doküman okuması gerektiriyor (users/{uid}) — üyenin gymId/trainerId
    // bilgisi custom claim'lerde değil, hedef kullanıcının kendi
    // dokümanında olduğu için.
    function targetUser(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    match /measurements/{uid}/entries/{entryId} {
      allow read, write: if isSignedIn() && (
        request.auth.uid == uid ||
        (myRole() == 'admin' && targetUser(uid).gymId == myGymId()) ||
        (myRole() == 'trainer' && targetUser(uid).trainerId == request.auth.uid)
      );
    }

    // groupSessions/{id} — F4-2. Oluşturma admin/antrenöre ait; üye
    // sadece kendi katılım durumunu (attendeeIds'e kendi uid'sini ekleme/
    // çıkarma) değiştirebilir. Kontenjan aşımı burada da (client'taki
    // transaction'a ek bir güvenlik katmanı olarak) engellenir:
    // request.resource.data.attendeeIds.size() <= capacity.
    function isJoiningGroupSession() {
      return request.resource.data.attendeeIds.size() == resource.data.attendeeIds.size() + 1 &&
        !resource.data.attendeeIds.hasAny([request.auth.uid]) &&
        request.resource.data.attendeeIds.hasAll(resource.data.attendeeIds) &&
        request.resource.data.attendeeIds.hasAny([request.auth.uid]) &&
        request.resource.data.attendeeIds.size() <= resource.data.capacity;
    }

    function isLeavingGroupSession() {
      return request.resource.data.attendeeIds.size() == resource.data.attendeeIds.size() - 1 &&
        resource.data.attendeeIds.hasAny([request.auth.uid]) &&
        !request.resource.data.attendeeIds.hasAny([request.auth.uid]) &&
        resource.data.attendeeIds.hasAll(request.resource.data.attendeeIds);
    }

    function isOwnAttendeeChange() {
      return myRole() == 'member' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendeeIds']) &&
        (isJoiningGroupSession() || isLeavingGroupSession());
    }

    match /groupSessions/{sessionId} {
      allow read: if isSignedIn() && resource.data.gymId == myGymId();
      allow create: if isSignedIn() && (myRole() == 'admin' || myRole() == 'trainer') &&
        request.resource.data.gymId == myGymId();
      allow update: if isSignedIn() && resource.data.gymId == myGymId() && (
        myRole() == 'admin' || myRole() == 'trainer' || isOwnAttendeeChange()
      );
      allow delete: if isSignedIn() && resource.data.gymId == myGymId() && (myRole() == 'admin' || myRole() == 'trainer');
    }
  }
}
