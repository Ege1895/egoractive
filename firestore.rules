rules_version = '2';

// F2-6 — Faz 2 kapsamında ince taneli rol/salon bazlı kurallar.
// Custom claim'ler (role/gymId) F2-5'teki trigger ile setCustomUserClaims'e
// yazılıyor; burada request.auth.token.role / .gymId olarak okunuyor.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return request.auth.token.role;
    }

    function myGymId() {
      return request.auth.token.gymId;
    }

    // gyms/{gymId} — sadece o salonun admin'i yazabilir, kimliği doğrulanmış
    // herkes kendi salonu için okuyabilir. Alt koleksiyonlar (themes vb.)
    // aynı kurala tabi.
    //
    // F6-1 — subscriptionStatus/subscriptionExpiresAt/subscriptionProductId/
    // subscriptionPlatform/trialStartedAt/trialUsed/subscriptionCancelAtPeriodEnd/
    // subscriptionLastVerificationData/subscriptionLastVerificationPlatform/
    // subscriptionExempt admin'in normal yazma yetkisinin DIŞINDA tutulur: bu
    // alanları sadece verifySubscriptionPurchase / webhook / günlük yenileme
    // Cloud Function'ları YA DA Firebase Console'dan elle (Admin SDK, kurallara
    // tabi değil) değiştirilebilir — yoksa bir admin kendi salonunu doğrudan
    // "active" yaparak, trialUsed'ı sıfırlayarak ya da subscriptionExempt'i
    // kendi kendine `true` yaparak abonelik ücreti ödemeden premium'a
    // geçebilirdi. `subscriptionExempt` BİLEREK sadece Console/Admin SDK'dan
    // set edilebilecek şekilde bırakıldı — test/demo salonlarını ödeme
    // almadan aktif tutmak için (bkz. `apply-subscription-update.ts` yorumu).
    function subscriptionFields() {
      return [
        'subscriptionStatus', 'subscriptionExpiresAt', 'subscriptionProductId',
        'subscriptionPlatform', 'trialStartedAt', 'trialUsed',
        'subscriptionCancelAtPeriodEnd', 'subscriptionLastVerificationData',
        'subscriptionLastVerificationPlatform', 'subscriptionExempt'
      ];
    }

    // Salon Abonelik ve Erişim Akışı — abonelik `trial`/`active` değilken
    // salonun TÜMÜ (admin dahil) normal veriye erişemez: sadece yeni içerik
    // oluşturma değil, MEVCUT kayıtları görüntüleme de kesilir (önceki F6-3
    // tasarımı sadece create'i engelliyordu, bu daha geniş kilitleme onun
    // yerini alıyor). `gyms/{gymId}` dokümanının kendisi ve `users/{ownUid}`
    // self-read'i BİLEREK bu kapsam dışında tutulur — client'ın durumu görüp
    // doğru ekrana (abonelik/engellendi) yönlenebilmesi için gerekli asgari
    // okuma. `subscriptionStatus` bir custom claim değil CANLI bir Firestore
    // alanı olduğu için, buradaki her `get()` en güncel durumu okur — token
    // yaşına bakılmaksızın erişim anında kesilir/açılır (ayrı bir
    // sessionVersion/JWT geçersiz kılma mekanizmasına gerek yok).
    // `subscriptionExempt == true` — Console'dan elle "abonelik gerekmiyor"
    // işaretlenmiş test/demo salonları — durumdan bağımsız her zaman aktif
    // sayılır.
    function gymSubscriptionActive(gymId) {
      let gym = get(/databases/$(database)/documents/gyms/$(gymId)).data;
      // `.get(key, default)` kullanılıyor — `subscriptionExempt` yeni bir
      // alan ve mevcut hiçbir salon dokümanında henüz yok; doğrudan `.`
      // erişimi eksik alanlarda hataya (dolayısıyla reddedilen bir kurala)
      // yol açar, `.get()` ise güvenle varsayılana düşer.
      return gym.get('subscriptionExempt', false) == true ||
        gym.get('subscriptionStatus', 'none') in ['trial', 'active'];
    }

    match /gyms/{gymId} {
      allow read: if isSignedIn() && myGymId() == gymId;
      allow create: if isSignedIn() && myRole() == 'admin' && myGymId() == gymId &&
        !request.resource.data.keys().hasAny(subscriptionFields());
      allow update: if isSignedIn() && myRole() == 'admin' && myGymId() == gymId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(subscriptionFields());
      allow delete: if isSignedIn() && myRole() == 'admin' && myGymId() == gymId;

      // `{document=**}` sıfır segmentle de eşleşip üst dokümanın (gym
      // doc'unun kendisinin) subscription alan kısıtlamasını atlatabiliyordu
      // (Firestore rules'ın belgelenmiş bir davranışı) — bu yüzden gerçek alt
      // koleksiyonlar (ör. packages) burada isimle eşleniyor, genel bir
      // wildcard değil.
      match /packages/{packageId} {
        allow read: if isSignedIn() && myGymId() == gymId && gymSubscriptionActive(gymId);
        allow create: if isSignedIn() && myRole() == 'admin' && myGymId() == gymId && gymSubscriptionActive(gymId);
        allow update, delete: if isSignedIn() && myRole() == 'admin' && myGymId() == gymId;
      }

      // subscriptionHistory/{id} — abonelik geçmişi ledger'ı, sadece Admin
      // SDK (verify/webhook/reverify) yazar; hiçbir client (admin dahil)
      // okuyup yazamaz.
      match /subscriptionHistory/{entryId} {
        allow read, write: if false;
      }

      // reportSnapshots/{snapshotId} — F5-7: haftalık/aylık scheduled
      // fonksiyonların yazdığı rapor özeti (Raporlar ekranının veri
      // kaynağı). Sadece Admin SDK yazar, salonun admin'i okuyabilir.
      match /reportSnapshots/{snapshotId} {
        allow read: if isSignedIn() && myRole() == 'admin' && myGymId() == gymId;
        allow write: if false;
      }

      // monthlyTrainerStats/{yearMonth} — F5-1/F7-2 dashboard antrenör
      // performansı için önceden hesaplanmış özet (bkz.
      // `on-session-write-update-trainer-stats.ts`). Sadece bu trigger
      // (Admin SDK, kurallara tabi değil) yazar; salonun admin'i okur.
      match /monthlyTrainerStats/{yearMonth} {
        allow read: if isSignedIn() && myRole() == 'admin' && myGymId() == gymId;
        allow write: if false;
      }
    }

    // subscriptionTransactions/{transactionKey} — store transaction/purchase
    // token'ından gymId'ye dönüş için webhook lookup index'i. Sadece Admin SDK.
    match /subscriptionTransactions/{transactionKey} {
      allow read, write: if false;
    }

    // users/{uid} — F1-10 (telefon numarasıyla kendi kaydını arama, Admin
    // SDK ile — kurallara tabi değil) ve F2-1/F2-2 (admin başka kullanıcı
    // dokümanı oluşturuyor) ile uyumlu:
    // - herkes kendi dokümanını okuyabilir
    // - admin kendi salonundaki (gymId eşleşen) herkesi okuyabilir/yazabilir
    // - antrenör sadece trainerId == kendi uid'si olan üyeleri okuyabilir
    match /users/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        (myRole() == 'admin' && resource.data.gymId == myGymId() && gymSubscriptionActive(myGymId())) ||
        (myRole() == 'trainer' && resource.data.trainerId == request.auth.uid && gymSubscriptionActive(myGymId()))
      );

      // F11-3 — client'ın KENDİ dokümanına asla yazamayacağı kimlik alanları:
      // - `email`/`emailLower` yalnızca OTP doğrulaması sonrası Cloud
      //   Functions (Admin SDK, kuralları atlar) tarafından yazılır. Bu kural
      //   önceden sadece `update`'te vardı; `create`'te hiçbir alan kısıtı
      //   olmadığı için aynı koruma hesap OLUŞTURMA anında atlanabiliyordu.
      // - `notificationProxyUid` bir kullanıcının bildirimlerinin BAŞKA bir
      //   cihaza gitmesini sağlıyor (bkz. `staff-notifications.ts`
      //   `resolveTokenSource`). Kendi kendine yazılabilseydi herkes kendi
      //   bildirimlerini bir başkasının telefonuna düşürebilirdi.
      // - `trainerProfileUid` admin ile gölge antrenör dokümanı arasındaki
      //   bağ; sadece admin kurar.
      //
      // Admin dalında `notificationProxyUid`/`trainerProfileUid` BİLEREK
      // serbest: gölge antrenörü oluşturan ve kendi dokümanına bağlayan
      // yazma (`addSelfAsTrainer`) o daldan geçiyor.
      function selfProtectedFields() {
        return ['email', 'emailLower', 'notificationProxyUid', 'trainerProfileUid'];
      }

      allow create: if isSignedIn() && (
        (request.auth.uid == uid &&
          !request.resource.data.keys().hasAny(selfProtectedFields())) ||
        (myRole() == 'admin' &&
          request.resource.data.gymId == myGymId() &&
          gymSubscriptionActive(myGymId()) &&
          !request.resource.data.keys().hasAny(['email', 'emailLower']))
      );

      allow update: if isSignedIn() && (
        // Egoractive Authentication Sistemi — email/emailLower SADECE Admin
        // SDK (Cloud Functions, kuralları atlar) üzerinden yazılabilir; yani
        // sadece OTP doğrulaması sonrası (verifyEmailSetupOtp/
        // verifyEmailChangeOtp). Client kendi dokümanını güncellerken
        // (ör. updateOwnInfo — ad/telefon) bu alanlara dokunamaz; korunan
        // alanların tamamı için bkz. `selfProtectedFields()`.
        (request.auth.uid == uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(selfProtectedFields())) ||
        (myRole() == 'admin' &&
          resource.data.gymId == myGymId() &&
          request.resource.data.gymId == myGymId()) ||
        // F3-5 — antrenör, seans oluşturma/iptal/tamamlama transaction'ının
        // parçası olarak üyenin SADECE remainingSessions ve
        // plannedSessionsCount alanlarını günceller (bkz.
        // SessionsWriteService, SessionCompletionService). Bunu üyenin O
        // ANKİ (resource.data.trainerId) atanmış antrenörüyle sınırlamak
        // hataydı: üyenin antrenörü değiştirildiğinde ya da tamamlanan seans
        // üyenin GÜNCEL atanmış antrenöründen farklı bir antrenöre aitse
        // (ör. antrenör değişikliğinden önce oluşturulmuş bir seans) yazma
        // PERMISSION_DENIED ile reddediliyordu — asıl yetki kontrolü zaten
        // sessions/{sessionId}'deki isCompletingOwnSession() ile
        // (resource.data.trainerId == request.auth.uid, SEANSIN kendi
        // antrenörüne göre) yapılıyor; burada sadece aynı salondan olma
        // şartı yeterli.
        (myRole() == 'trainer' &&
          resource.data.gymId == myGymId() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['remainingSessions', 'plannedSessionsCount']))
      );

      allow delete: if isSignedIn() && myRole() == 'admin' && resource.data.gymId == myGymId();
    }

    // phoneIndex/{phoneNumber} — F2-2 perf. `checkPhoneAvailable` callable'ının
    // (cold start'ta 20-30+ saniyeye çıkabiliyordu) yerini alan, sadece
    // varlık kontrolü için tutulan index. İçeriği sahibinin uid'i dışında
    // bir şey taşımaz, salon gözetmeksizin herhangi bir oturum açmış kullanıcı
    // "bu numara alınmış mı" diye okuyabilir — client asla yazamaz, sadece
    // `on-user-write-sync-phone-index.ts` trigger'ı (Admin SDK) yazar.
    match /phoneIndex/{phoneNumber} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // memberPackages/{id} — F3-2. Fiyat alanları (totalAmount/paidAmount/
    // dueAmount) içerdiği için sadece admin erişebilir; üye kendi paketini
    // ayrı, fiyatsız bir görünümden (users/{uid} üzerindeki denormalize
    // remainingSessions/packageEndDate alanları) okur, bu koleksiyona hiç
    // dokunmaz.
    match /memberPackages/{packageId} {
      allow read: if isSignedIn() && myRole() == 'admin' && resource.data.gymId == myGymId() && gymSubscriptionActive(myGymId());
      allow update, delete: if isSignedIn() && myRole() == 'admin' && resource.data.gymId == myGymId();
      allow create: if isSignedIn() && myRole() == 'admin' && request.resource.data.gymId == myGymId() &&
        gymSubscriptionActive(myGymId());
    }

    // sessions/{sessionId} — F3-3. Oluşturma admin ekranlarından ya da
    // antrenörün KENDİ takvim/üye detay ekranından (create_session_sheet.dart,
    // lockedTrainerId ile) yapılabilir — antrenör başka bir antrenöre seans
    // atayamaz, sadece trainerId kendi uid'si olan bir doküman oluşturabilir.
    // İptal/erteleme admin için her zaman izinli; üye kendi seansı içinse ve
    // başlangıca 24 saatten fazla varsa izinli. Antrenör kendi seansı içinse
    // ve başlangıca 24 saatten fazla varsa AYRICA admin'in o antrenöre
    // Yetki Ayarları'ndan verdiği izne bağlı — iptal ve erteleme ayrı ayrı
    // yetkilendirilebiliyor (bkz. trainerPermission()). Remote Config'teki
    // cancellationDeadlineHours (varsayılan 24) buradaki 24 saatlik sabitle
    // senkron tutulmalı — Security Rules harici bir servise (Remote Config)
    // erişemediği için buraya sabit olarak yazılıyor.
    function isOwnTrainerSession() {
      return myRole() == 'trainer' && resource.data.trainerId == request.auth.uid;
    }

    function withinCancellationWindow() {
      return resource.data.startTime - request.time > duration.value(24, 'h');
    }

    // F3-4 — üye "Gelicem"/"Gelmeyeceğim" derken sadece kendi seansının
    // memberConfirmation alanını değiştiriyor; bu, 24 saatlik iptal
    // penceresinden bağımsız (dersten 1 saat önce de onay verebilmeli).
    function isOwnMemberSession() {
      return myRole() == 'member' && resource.data.memberId == request.auth.uid;
    }

    // Admin, Yetki Ayarları'ndan her antrenöre ayrı ayrı "üye seanslarını
    // iptal edebilir"/"erteleyebilir" yetkisi verip alabiliyor
    // (`gyms/{gymId}.trainerPermissions.{trainerId}.canCancelMemberSessions`/
    // `.canRescheduleMemberSessions`, bkz. `trainer_permissions_controller.dart`).
    // Alan hiç yoksa (yeni bir antrenör, ya da admin hiç dokunmamış) `true`a
    // düşülür — bu iki yetki mevcut davranışı KISITLAMAK için var, varsayılan
    // olarak herkes zaten yapabiliyordu.
    function trainerPermission(field) {
      let gym = get(/databases/$(database)/documents/gyms/$(myGymId())).data;
      return gym.get('trainerPermissions', {}).get(request.auth.uid, {}).get(field, true) == true;
    }

    function isCancellingSession() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status == 'cancelled';
    }

    function isReschedulingSession() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(
        ['startTime', 'endTime', 'confirmationRequested', 'completionPushSent']
      );
    }

    function onlyChangesConfirmation() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberConfirmation']);
    }

    // Antrenör bir seansın başlangıcından itibaren 24 saat içinde
    // "tamamlandı"/"üye gelmedi" onayı verebilir — bu pencere
    // `withinCancellationWindow()`daki (başlangıçtan ÖNCEKİ 24 saat)
    // pencereyle karıştırılmamalı, bu BAŞLANGIÇTAN SONRAKİ 24 saat.
    // Süre geçtikten sonra sadece admin (myRole() == 'admin' dalı) bu
    // seansı tamamlanmış işaretleyebilir — client tarafında
    // `trainer_calendar_panel.dart`'taki "Dersi onayla" sheet'i de aynı
    // pencereyi kontrol edip süre geçmişse butonları devre dışı bırakıyor.
    function withinCompletionWindow() {
      return request.time < resource.data.startTime + duration.value(24, 'h');
    }

    // F3-5 — antrenör kendi seansını "tamamlandı"/"üye gelmedi" olarak
    // işaretlerken sadece status+attended alanlarını değiştiriyor.
    function isCompletingOwnSession() {
      return myRole() == 'trainer' &&
        resource.data.trainerId == request.auth.uid &&
        resource.data.status == 'planned' &&
        request.resource.data.status == 'completed' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'attended']) &&
        withinCompletionWindow();
    }

    // F3-3/F3-5 — okuma kuralı önceden tek başına resource.data.gymId ==
    // myGymId() idi. Bu, admin'in gymId ile filtrelenmiş sorguları için
    // çalışıyordu ama antrenörün trainerId ile, üyenin memberId ile
    // filtrelediği TÜM sorguları sessizce reddediyordu — Firestore, bir
    // "list"/"listen" sorgusunu sadece kuralın kullandığı alan sorgunun
    // KENDİ filtresinde de varsa "kanıtlanabilir" sayıp izin veriyor;
    // aksi halde sorgunun tamamını "Missing or insufficient permissions"
    // ile reddediyor (dönen dokümanların gerçekte kurala uyup uymadığına
    // hiç bakmadan). Antrenörün bugünkü program/onay bekleyenler akışı ve
    // üyenin kendi seans listesi bu yüzden HİÇ veri almıyordu — bu,
    // "tamamlandı/gelmedi" isteğinin sürekli reddedilmesinin asıl kök
    // nedeniydi (yazma kuralı değil, okuma kuralıydı).
    match /sessions/{sessionId} {
      allow read: if isSignedIn() && gymSubscriptionActive(myGymId()) && (
        (myRole() == 'admin' && resource.data.gymId == myGymId()) ||
        (myRole() == 'trainer' && resource.data.trainerId == request.auth.uid) ||
        (myRole() == 'member' && resource.data.memberId == request.auth.uid)
      );
      allow create: if isSignedIn() && request.resource.data.gymId == myGymId() &&
        gymSubscriptionActive(myGymId()) && (
          myRole() == 'admin' ||
          (myRole() == 'trainer' && request.resource.data.trainerId == request.auth.uid)
        );
      allow update, delete: if isSignedIn() && resource.data.gymId == myGymId() && (
        myRole() == 'admin' ||
        (isOwnTrainerSession() && withinCancellationWindow() && isCancellingSession() && trainerPermission('canCancelMemberSessions')) ||
        (isOwnTrainerSession() && withinCancellationWindow() && isReschedulingSession() && trainerPermission('canRescheduleMemberSessions')) ||
        (isOwnMemberSession() && withinCancellationWindow()) ||
        (isOwnMemberSession() && onlyChangesConfirmation()) ||
        isCompletingOwnSession()
      );
    }

    // measurements/{uid}/entries/{entryId} — F4-1. Vücut ölçümü kişisel/
    // hassas sağlık verisi (F0-4 gizlilik politikası kapsamında) ama admin
    // ve kendi antrenörü, üyenin ölçüm ekranını üye detayından açıp
    // görüntüleyip düzenleyebiliyor (stüdyo içi kullanım) — üçüncü bir
    // salonun admin/antrenörüne asla açılmıyor. `targetUser()` bir ekstra
    // doküman okuması gerektiriyor (users/{uid}) — üyenin gymId/trainerId
    // bilgisi custom claim'lerde değil, hedef kullanıcının kendi
    // dokümanında olduğu için.
    function targetUser(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    match /measurements/{uid}/entries/{entryId} {
      allow read, write: if isSignedIn() && gymSubscriptionActive(myGymId()) && (
        request.auth.uid == uid ||
        (myRole() == 'admin' && targetUser(uid).gymId == myGymId()) ||
        (myRole() == 'trainer' && targetUser(uid).trainerId == request.auth.uid)
      );
    }

    // Kontenjanlı katılım listeleri (groupSessions F4-2, events F4-3) —
    // ortak kural mantığı. Oluşturma admin/antrenöre ait; üye sadece kendi
    // katılım durumunu (attendeeIds'e kendi uid'sini ekleme/çıkarma)
    // değiştirebilir. Kontenjan aşımı burada da (client'taki
    // CapacityService transaction'ına ek bir güvenlik katmanı olarak)
    // engellenir. `capacity == null` sınırsız demektir, hiç kontrol
    // yapılmaz (bazı etkinliklerde olduğu gibi).
    function withinCapacity() {
      return resource.data.capacity == null ||
        request.resource.data.attendeeIds.size() <= resource.data.capacity;
    }

    function isJoiningCapacityList() {
      return request.resource.data.attendeeIds.size() == resource.data.attendeeIds.size() + 1 &&
        !resource.data.attendeeIds.hasAny([request.auth.uid]) &&
        request.resource.data.attendeeIds.hasAll(resource.data.attendeeIds) &&
        request.resource.data.attendeeIds.hasAny([request.auth.uid]) &&
        withinCapacity();
    }

    function isLeavingCapacityList() {
      return request.resource.data.attendeeIds.size() == resource.data.attendeeIds.size() - 1 &&
        resource.data.attendeeIds.hasAny([request.auth.uid]) &&
        !request.resource.data.attendeeIds.hasAny([request.auth.uid]) &&
        resource.data.attendeeIds.hasAll(request.resource.data.attendeeIds);
    }

    function isOwnAttendeeChange() {
      return myRole() == 'member' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendeeIds']) &&
        (isJoiningCapacityList() || isLeavingCapacityList());
    }

    match /groupSessions/{sessionId} {
      allow read: if isSignedIn() && resource.data.gymId == myGymId() && gymSubscriptionActive(myGymId());
      // Grup dersi/etkinlik oluşturma sadece admin'e ait — antrenör kendi
      // takviminden sadece birebir seans oluşturabiliyor (client'ta zaten
      // trainer_calendar_panel.dart'ın "+" butonu buna göre değiştirildi,
      // bu kural client atlatılsa bile geçerli olan gerçek sınır).
      allow create: if isSignedIn() && myRole() == 'admin' &&
        request.resource.data.gymId == myGymId() && gymSubscriptionActive(myGymId());
      // Antrenör bu koleksiyona (grup dersi/etkinlik) sadece görüntüleyici —
      // düzenleme/iptal SADECE admin'e ait. Üyenin kendi katılım/ayrılma
      // yazması `isOwnAttendeeChange()` ile ayrıca izinli.
      allow update: if isSignedIn() && resource.data.gymId == myGymId() && (
        myRole() == 'admin' || isOwnAttendeeChange()
      );
      allow delete: if isSignedIn() && resource.data.gymId == myGymId() && myRole() == 'admin';
    }

    // events/{id} — F4-3. groupSessions ile aynı kontenjan kuralları.
    match /events/{eventId} {
      allow read: if isSignedIn() && resource.data.gymId == myGymId() && gymSubscriptionActive(myGymId());
      allow create: if isSignedIn() && myRole() == 'admin' &&
        request.resource.data.gymId == myGymId() && gymSubscriptionActive(myGymId());
      allow update: if isSignedIn() && resource.data.gymId == myGymId() && (
        myRole() == 'admin' || isOwnAttendeeChange()
      );
      allow delete: if isSignedIn() && resource.data.gymId == myGymId() && myRole() == 'admin';
    }

    // expenses/{id} — F5-1 dashboard'ının gider toplamı okuduğu koleksiyon
    // (giriş ekranı F5-3'te gelecek). memberPackages ile aynı hassasiyet:
    // sadece kendi salonunun admin'i erişir.
    match /expenses/{expenseId} {
      allow read: if isSignedIn() && myRole() == 'admin' && resource.data.gymId == myGymId() && gymSubscriptionActive(myGymId());
      allow update, delete: if isSignedIn() && myRole() == 'admin' && resource.data.gymId == myGymId();
      allow create: if isSignedIn() && myRole() == 'admin' && request.resource.data.gymId == myGymId() &&
        gymSubscriptionActive(myGymId());
    }

    // feedback/{id} — F5-4. Üye kendi geri bildirimini yazar (değiştiremez/
    // silemez, gönderim tek seferlik); sadece stüdyo yönetimi (admin) okur —
    // antrenöre hiç açılmıyor (F5-4 gizlilik notu: "antrenörüne isimsiz
    // iletilir" — bu app'te antrenör tarafında hiç gösterilmiyor).
    match /feedback/{feedbackId} {
      allow read: if isSignedIn() && myRole() == 'admin' && resource.data.gymId == myGymId() && gymSubscriptionActive(myGymId());
      allow create: if isSignedIn() && myRole() == 'member' &&
        request.resource.data.gymId == myGymId() &&
        request.resource.data.memberId == request.auth.uid;
    }

    // internal/{document=**} — `refreshRemoteConfigCache`'in 2 saatte bir
    // yazdığı Remote Config önbelleği (shared/remote-config-cache.ts).
    // Sadece Cloud Functions'ın Admin SDK'sı okur/yazar (kurallara tabi
    // değil) — hiçbir client bu koleksiyona hiçbir şekilde erişemez.
    // Eşleşmeyen yollar zaten varsayılan olarak reddedilir, bu kural sadece
    // niyeti açıkça belgelemek için var.
    match /internal/{document=**} {
      allow read, write: if false;
    }
  }
}
