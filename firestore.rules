rules_version = '2';

// F1-8 — temel Security Rules. Rol/salon bazlı ince kapsam F2-6'da eklenecek
// (custom claims F1-11/F2-5'te bağlanana kadar burada sadece "giriş yapmış
// kullanıcı" kontrolü var — herkese açık okuma/yazma yok).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
