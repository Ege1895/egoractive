rules_version = '2';

// F2-6 — Faz 2 kapsamında ince taneli rol/salon bazlı kurallar.
// Custom claim'ler (role/gymId) F2-5'teki trigger ile setCustomUserClaims'e
// yazılıyor; burada request.auth.token.role / .gymId olarak okunuyor.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return request.auth.token.role;
    }

    function myGymId() {
      return request.auth.token.gymId;
    }

    // gyms/{gymId} — sadece o salonun admin'i yazabilir, kimliği doğrulanmış
    // herkes kendi salonu için okuyabilir. Alt koleksiyonlar (themes vb.)
    // aynı kurala tabi.
    //
    // F6-1 — subscriptionStatus/subscriptionExpiresAt/subscriptionProductId/
    // subscriptionPlatform/trialStartedAt admin'in normal yazma yetkisinin
    // DIŞINDA tutulur: bu alanları sadece verifySubscriptionPurchase Cloud
    // Function'ı (Admin SDK, kurallara tabi değil) değiştirebilir — yoksa bir
    // admin kendi salonunu doğrudan "active" yaparak abonelik ücreti
    // ödemeden premium'a geçebilirdi.
    function subscriptionFields() {
      return ['subscriptionStatus', 'subscriptionExpiresAt', 'subscriptionProductId', 'subscriptionPlatform', 'trialStartedAt'];
    }

    // F6-3 — deneme süresi dolan (trialExpiryCheck scheduled function
    // 'trial'ı süresi dolunca 'expired'e çevirir) ya da aboneliği sona eren
    // bir salon yeni içerik (üye/paket satışı/seans/grup dersi/etkinlik/
    // gider/paket kataloğu) OLUŞTURAMAZ — mevcut kayıtları görüntüleme/
    // düzenleme/silme etkilenmez. Client tarafında `subscription_write_gate.dart`
    // aynı durumu proaktif kontrol edip "aboneliğini yenile" uyarısı
    // gösteriyor, ama bu kural client atlatılsa bile geçerli olan gerçek
    // güvenlik sınırı.
    function gymSubscriptionAllowsWrite(gymId) {
      return get(/databases/$(database)/documents/gyms/$(gymId)).data.subscriptionStatus in ['trial', 'active'];
    }

    match /gyms/{gymId} {
      allow read: if isSignedIn() && myGymId() == gymId;
      allow create: if isSignedIn() && myRole() == 'admin' && myGymId() == gymId &&
        request.resource.data.subscriptionStatus == 'trial';
      allow update: if isSignedIn() && myRole() == 'admin' && myGymId() == gymId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(subscriptionFields());
      allow delete: if isSignedIn() && myRole() == 'admin' && myGymId() == gymId;

      // `{document=**}` sıfır segmentle de eşleşip üst dokümanın (gym
      // doc'unun kendisinin) subscription alan kısıtlamasını atlatabiliyordu
      // (Firestore rules'ın belgelenmiş bir davranışı) — bu yüzden gerçek alt
      // koleksiyonlar (ör. packages) burada isimle eşleniyor, genel bir
      // wildcard değil.
      match /packages/{packageId} {
        allow read: if isSignedIn() && myGymId() == gymId;
        allow create: if isSignedIn() && myRole() == 'admin' && myGymId() == gymId && gymSubscriptionAllowsWrite(gymId);
        allow update, delete: if isSignedIn() && myRole() == 'admin' && myGymId() == gymId;
      }
    }

    // users/{uid} — F1-10 (telefon numarasıyla kendi kaydını arama, Admin
    // SDK ile — kurallara tabi değil) ve F2-1/F2-2 (admin başka kullanıcı
    // dokümanı oluşturuyor) ile uyumlu:
    // - herkes kendi dokümanını okuyabilir
    // - admin kendi salonundaki (gymId eşleşen) herkesi okuyabilir/yazabilir
    // - antrenör sadece trainerId == kendi uid'si olan üyeleri okuyabilir
    match /users/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        (myRole() == 'admin' && resource.data.gymId == myGymId()) ||
        (myRole() == 'trainer' && resource.data.trainerId == request.auth.uid)
      );

      allow create: if isSignedIn() && (
        request.auth.uid == uid ||
        (myRole() == 'admin' && request.resource.data.gymId == myGymId() && gymSubscriptionAllowsWrite(myGymId()))
      );

      allow update: if isSignedIn() && (
        request.auth.uid == uid ||
        (myRole() == 'admin' &&
          resource.data.gymId == myGymId() &&
          request.resource.data.gymId == myGymId()) ||
        // F3-5 — antrenör, ders tamamlama transaction'ının parçası olarak
        // üyenin SADECE remainingSessions alanını düşürür. Bunu üyenin O
        // ANKİ (resource.data.trainerId) atanmış antrenörüyle sınırlamak
        // hataydı: üyenin antrenörü değiştirildiğinde ya da tamamlanan seans
        // üyenin GÜNCEL atanmış antrenöründen farklı bir antrenöre aitse
        // (ör. antrenör değişikliğinden önce oluşturulmuş bir seans) yazma
        // PERMISSION_DENIED ile reddediliyordu — asıl yetki kontrolü zaten
        // sessions/{sessionId}'deki isCompletingOwnSession() ile
        // (resource.data.trainerId == request.auth.uid, SEANSIN kendi
        // antrenörüne göre) yapılıyor; burada sadece aynı salondan olma
        // şartı yeterli.
        (myRole() == 'trainer' &&
          resource.data.gymId == myGymId() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['remainingSessions']))
      );

      allow delete: if isSignedIn() && myRole() == 'admin' && resource.data.gymId == myGymId();
    }

    // memberPackages/{id} — F3-2. Fiyat alanları (totalAmount/paidAmount/
    // dueAmount) içerdiği için sadece admin erişebilir; üye kendi paketini
    // ayrı, fiyatsız bir görünümden (users/{uid} üzerindeki denormalize
    // remainingSessions/packageEndDate alanları) okur, bu koleksiyona hiç
    // dokunmaz.
    match /memberPackages/{packageId} {
      allow read, update, delete: if isSignedIn() && myRole() == 'admin' && resource.data.gymId == myGymId();
      allow create: if isSignedIn() && myRole() == 'admin' && request.resource.data.gymId == myGymId() &&
        gymSubscriptionAllowsWrite(myGymId());
    }

    // sessions/{sessionId} — F3-3. Oluşturma sadece admin ekranlarından
    // (client'ta başka bir yol yok). İptal/erteleme admin için her zaman
    // izinli; antrenör/üye kendi seansı içinse ve başlangıca 24 saatten
    // fazla varsa izinli. Remote Config'teki cancellationDeadlineHours
    // (varsayılan 24) buradaki 24 saatlik sabitle senkron tutulmalı —
    // Security Rules harici bir servise (Remote Config) erişemediği için
    // buraya sabit olarak yazılıyor.
    function isOwnSession() {
      return (myRole() == 'trainer' && resource.data.trainerId == request.auth.uid) ||
             (myRole() == 'member' && resource.data.memberId == request.auth.uid);
    }

    function withinCancellationWindow() {
      return resource.data.startTime - request.time > duration.value(24, 'h');
    }

    // F3-4 — üye "Gelicem"/"Gelmeyeceğim" derken sadece kendi seansının
    // memberConfirmation alanını değiştiriyor; bu, 24 saatlik iptal
    // penceresinden bağımsız (dersten 1 saat önce de onay verebilmeli).
    function isOwnMemberSession() {
      return myRole() == 'member' && resource.data.memberId == request.auth.uid;
    }

    function onlyChangesConfirmation() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberConfirmation']);
    }

    // F3-5 — antrenör kendi seansını "tamamlandı"/"üye gelmedi" olarak
    // işaretlerken sadece status+attended alanlarını değiştiriyor; bu,
    // ders zaten bittiği (dolayısıyla 24 saatlik pencerenin çoktan geçmiş
    // olacağı) için 24 saat kuralından bağımsız tutuluyor.
    function isCompletingOwnSession() {
      return myRole() == 'trainer' &&
        resource.data.trainerId == request.auth.uid &&
        resource.data.status == 'planned' &&
        request.resource.data.status == 'completed' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'attended']);
    }

    // F3-3/F3-5 — okuma kuralı önceden tek başına resource.data.gymId ==
    // myGymId() idi. Bu, admin'in gymId ile filtrelenmiş sorguları için
    // çalışıyordu ama antrenörün trainerId ile, üyenin memberId ile
    // filtrelediği TÜM sorguları sessizce reddediyordu — Firestore, bir
    // "list"/"listen" sorgusunu sadece kuralın kullandığı alan sorgunun
    // KENDİ filtresinde de varsa "kanıtlanabilir" sayıp izin veriyor;
    // aksi halde sorgunun tamamını "Missing or insufficient permissions"
    // ile reddediyor (dönen dokümanların gerçekte kurala uyup uymadığına
    // hiç bakmadan). Antrenörün bugünkü program/onay bekleyenler akışı ve
    // üyenin kendi seans listesi bu yüzden HİÇ veri almıyordu — bu,
    // "tamamlandı/gelmedi" isteğinin sürekli reddedilmesinin asıl kök
    // nedeniydi (yazma kuralı değil, okuma kuralıydı).
    match /sessions/{sessionId} {
      allow read: if isSignedIn() && (
        (myRole() == 'admin' && resource.data.gymId == myGymId()) ||
        (myRole() == 'trainer' && resource.data.trainerId == request.auth.uid) ||
        (myRole() == 'member' && resource.data.memberId == request.auth.uid)
      );
      allow create: if isSignedIn() && myRole() == 'admin' && request.resource.data.gymId == myGymId() &&
        gymSubscriptionAllowsWrite(myGymId());
      allow update, delete: if isSignedIn() && resource.data.gymId == myGymId() && (
        myRole() == 'admin' ||
        (isOwnSession() && withinCancellationWindow()) ||
        (isOwnMemberSession() && onlyChangesConfirmation()) ||
        isCompletingOwnSession()
      );
    }

    // measurements/{uid}/entries/{entryId} — F4-1. Vücut ölçümü kişisel/
    // hassas sağlık verisi (F0-4 gizlilik politikası kapsamında) ama admin
    // ve kendi antrenörü, üyenin ölçüm ekranını üye detayından açıp
    // görüntüleyip düzenleyebiliyor (stüdyo içi kullanım) — üçüncü bir
    // salonun admin/antrenörüne asla açılmıyor. `targetUser()` bir ekstra
    // doküman okuması gerektiriyor (users/{uid}) — üyenin gymId/trainerId
    // bilgisi custom claim'lerde değil, hedef kullanıcının kendi
    // dokümanında olduğu için.
    function targetUser(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    match /measurements/{uid}/entries/{entryId} {
      allow read, write: if isSignedIn() && (
        request.auth.uid == uid ||
        (myRole() == 'admin' && targetUser(uid).gymId == myGymId()) ||
        (myRole() == 'trainer' && targetUser(uid).trainerId == request.auth.uid)
      );
    }

    // Kontenjanlı katılım listeleri (groupSessions F4-2, events F4-3) —
    // ortak kural mantığı. Oluşturma admin/antrenöre ait; üye sadece kendi
    // katılım durumunu (attendeeIds'e kendi uid'sini ekleme/çıkarma)
    // değiştirebilir. Kontenjan aşımı burada da (client'taki
    // CapacityService transaction'ına ek bir güvenlik katmanı olarak)
    // engellenir. `capacity == null` sınırsız demektir, hiç kontrol
    // yapılmaz (bazı etkinliklerde olduğu gibi).
    function withinCapacity() {
      return resource.data.capacity == null ||
        request.resource.data.attendeeIds.size() <= resource.data.capacity;
    }

    function isJoiningCapacityList() {
      return request.resource.data.attendeeIds.size() == resource.data.attendeeIds.size() + 1 &&
        !resource.data.attendeeIds.hasAny([request.auth.uid]) &&
        request.resource.data.attendeeIds.hasAll(resource.data.attendeeIds) &&
        request.resource.data.attendeeIds.hasAny([request.auth.uid]) &&
        withinCapacity();
    }

    function isLeavingCapacityList() {
      return request.resource.data.attendeeIds.size() == resource.data.attendeeIds.size() - 1 &&
        resource.data.attendeeIds.hasAny([request.auth.uid]) &&
        !request.resource.data.attendeeIds.hasAny([request.auth.uid]) &&
        resource.data.attendeeIds.hasAll(request.resource.data.attendeeIds);
    }

    function isOwnAttendeeChange() {
      return myRole() == 'member' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendeeIds']) &&
        (isJoiningCapacityList() || isLeavingCapacityList());
    }

    match /groupSessions/{sessionId} {
      allow read: if isSignedIn() && resource.data.gymId == myGymId();
      // Grup dersi/etkinlik oluşturma sadece admin'e ait — antrenör kendi
      // takviminden sadece birebir seans oluşturabiliyor (client'ta zaten
      // trainer_calendar_panel.dart'ın "+" butonu buna göre değiştirildi,
      // bu kural client atlatılsa bile geçerli olan gerçek sınır).
      allow create: if isSignedIn() && myRole() == 'admin' &&
        request.resource.data.gymId == myGymId() && gymSubscriptionAllowsWrite(myGymId());
      allow update: if isSignedIn() && resource.data.gymId == myGymId() && (
        myRole() == 'admin' || myRole() == 'trainer' || isOwnAttendeeChange()
      );
      allow delete: if isSignedIn() && resource.data.gymId == myGymId() && (myRole() == 'admin' || myRole() == 'trainer');
    }

    // events/{id} — F4-3. groupSessions ile aynı kontenjan kuralları.
    match /events/{eventId} {
      allow read: if isSignedIn() && resource.data.gymId == myGymId();
      allow create: if isSignedIn() && myRole() == 'admin' &&
        request.resource.data.gymId == myGymId() && gymSubscriptionAllowsWrite(myGymId());
      allow update: if isSignedIn() && resource.data.gymId == myGymId() && (
        myRole() == 'admin' || myRole() == 'trainer' || isOwnAttendeeChange()
      );
      allow delete: if isSignedIn() && resource.data.gymId == myGymId() && (myRole() == 'admin' || myRole() == 'trainer');
    }

    // expenses/{id} — F5-1 dashboard'ının gider toplamı okuduğu koleksiyon
    // (giriş ekranı F5-3'te gelecek). memberPackages ile aynı hassasiyet:
    // sadece kendi salonunun admin'i erişir.
    match /expenses/{expenseId} {
      allow read, update, delete: if isSignedIn() && myRole() == 'admin' && resource.data.gymId == myGymId();
      allow create: if isSignedIn() && myRole() == 'admin' && request.resource.data.gymId == myGymId() &&
        gymSubscriptionAllowsWrite(myGymId());
    }

    // feedback/{id} — F5-4. Üye kendi geri bildirimini yazar (değiştiremez/
    // silemez, gönderim tek seferlik); sadece stüdyo yönetimi (admin) okur —
    // antrenöre hiç açılmıyor (F5-4 gizlilik notu: "antrenörüne isimsiz
    // iletilir" — bu app'te antrenör tarafında hiç gösterilmiyor).
    match /feedback/{feedbackId} {
      allow read: if isSignedIn() && myRole() == 'admin' && resource.data.gymId == myGymId();
      allow create: if isSignedIn() && myRole() == 'member' &&
        request.resource.data.gymId == myGymId() &&
        request.resource.data.memberId == request.auth.uid;
    }
  }
}
