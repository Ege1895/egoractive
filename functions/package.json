{
  "name": "functions",
  "scripts": {
    "lint": "eslint .",
    "test": "npm run build && node --test lib/**/*.test.js",
    "test:rules": "npm run build && firebase emulators:exec --only firestore,storage --project egoractive-rules-test \"node --test lib/rules/*.rules-test.js\"",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "migrate:phone-e164": "npm run build && node lib/scripts/migrate-phone-e164.js",
    "migrate:gym-currency": "npm run build && node lib/scripts/migrate-gym-currency.js"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.3.2",
    "google-auth-library": "^9.15.1"
  },
  "private": true,
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "firebase": "^12.18.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  }
}
