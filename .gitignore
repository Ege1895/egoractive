# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# graphify — regenerable cache and machine-local interpreter/path pointers.
# graph.json/graph.html/GRAPH_REPORT.md etc. stay tracked.
graphify-out/cache/
graphify-out/.graphify_python
graphify-out/.graphify_root

# Firebase Extensions — local instance config can contain plaintext secrets
# (e.g. SMTP_CONNECTION_URI with embedded credentials) and machine-local
# emulator secrets. Never commit these.
extensions/*.env
extensions/*.env.local
extensions/*.secret.*
