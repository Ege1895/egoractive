rules_version = '2';

// F2-1 — temel Storage kuralları. Sadece giriş yapmış kullanıcılar salon
// logosu yükleyebilir/okuyabilir. Rol/salon bazlı ince kapsam (sadece o
// salonun admin'i kendi logosunu değiştirebilsin) F2-6 ile birlikte
// Firestore Security Rules genişlemesine paralel eklenecek.
//
// Storage'ı ücretsiz kotada tutmak için yazma; sadece PNG ve en fazla
// 300KB kabul eder (client zaten 128x128'e küçültüp PNG olarak yükler —
// bu kural gerçek garantiyi değil, kötü niyetli/eski client'lara karşı
// bir güvenlik tabanını sağlar).
service firebase.storage {
  match /b/{bucket}/o {
    match /gym_logos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.contentType == 'image/png'
                   && request.resource.size < 300 * 1024;
    }

    // Egoractive marka varlıkları (ör. OTP email şablonundaki logo,
    // bkz. shared/otp-email-template.ts) — sadece Admin SDK (Cloud
    // Console/gcloud) yazabilir, client'tan hiçbir zaman yazılmaz.
    match /branding/{fileName} {
      allow read: if true;
      allow write: if false;
    }
  }
}
